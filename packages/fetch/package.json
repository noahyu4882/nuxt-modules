{
  "name": "@noahyu/nuxt-fetch",
  "version": "2.0.0",
  "description": "Secure and easy http proxy integration with Nuxt.js",
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    },
    "./dist/runtime/*": "./dist/runtime/*",
    "./runtime/*": "./dist/runtime/*",
    "./*": "./*"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "stub": "nuxt-module-build --stub",
    "changelog": "conventional-changelog -n '../../changelog.config.js' -i CHANGELOG.md -s -r 0 -k ./package.json --commit-path ./"
  },
  "keywords": [
    "Nuxt Modules"
  ],
  "author": "Noah Yu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noah-Ywh/nuxt-modules.git",
    "directory": "packages/fetch"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nuxt/kit": "^4.2.2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.2"
  }
}
